# ==========================================================
# Grok Translator Suite — Environment Variables Template
# ==========================================================

# --- 1. Global Ports ---
PROGROK_WEB_PORT=3080
PROGROK_SOLVER_PORT=5072
GROK2API_PORT=3001
TRANSLATION_VALIDATOR_PORT=3002

# --- 2. Security & Credentials ---
# Generate with: openssl rand -hex 32
GROK2API_JWT_SECRET=change_me_to_a_random_64_character_hex_string
# Generate with: openssl rand -base64 32
GROK2API_CREDENTIAL_KEY=change_me_to_a_random_base64_string_for_encryption=
GROK2API_ADMIN_USER=admin
GROK2API_ADMIN_PASS=ChangeMe_SecurePassword123!

# Client API key for Grok2API / Validator
TRANSLATION_API_KEY=sk-grok-translator-default-key

# --- 3. Upstream & Proxy Settings ---
# Outbound proxy for registration and Grok queries (optional, e.g. http://127.0.0.1:7890)
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# --- 4. Quality & Translation Validator Settings ---
# Upstream address for Translation Validator (defaults to Grok2API at port 3001)
VALIDATOR_UPSTREAM_URL=http://grok2api:8000
VALIDATOR_PRIMARY_MODEL=grok-4.20-0309-reasoning
VALIDATOR_FALLBACK_MODEL=grok-4.20-0309-non-reasoning
VALIDATOR_PROMPT_PROFILE=neutral_v1
